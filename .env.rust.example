# ============================================================
# Sophia — Rust版 環境変数テンプレート
# ============================================================

# データベース
DATABASE_URL=postgresql://sophia:change-me@localhost:5432/sophia

# サーバー
PORT=8111
BASE_URL=http://localhost:8111

# セキュリティ
# SECRET_KEY: 例: openssl rand -hex 32 で作った値を入れる(見本には値を書かない)
SECRET_KEY=

# SMTP（Gmail）
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Webhook（GAS連携）
WEBHOOK_SECRET=
GOOGLE_CHAT_WEBHOOK_URL=

# PostgreSQL
DB_NAME=
DB_USER=
# DB_PASSWORD: 例: openssl rand -hex 24 で作った値を入れる(見本には値を書かない)
DB_PASSWORD=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Google Drive API（サービスアカウント）
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_FILE=

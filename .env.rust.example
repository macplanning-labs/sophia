# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=change-me

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Google Drive API（サービスアカウント）
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_FILE=

# データベース
DATABASE_URL=postgresql://sophia:change-me@localhost:5432/sophia

# サーバー
PORT=8111
BASE_URL=http://localhost:8111

# セキュリティ
SECRET_KEY=change-me

# SMTP（Gmail）
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Webhook（GAS連携）
WEBHOOK_SECRET=

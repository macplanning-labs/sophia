# ============================================================
# Dockerfile.rust — クロスコンパイル済みバイナリ用（Rust版）
# ============================================================

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pip \
    && pip3 install --no-cache-dir --break-system-packages reportlab \
    && rm -rf /var/lib/apt/lists/*

COPY target/x86_64-unknown-linux-musl/release/sophia /usr/local/bin/app
COPY static/ /app/static/
COPY migrations/ /app/migrations/
COPY fonts/ /app/fonts/
COPY scripts/pdf/ /app/scripts/pdf/
COPY .env.rust.example /app/.env.example

WORKDIR /app
RUN mkdir -p /app/data /app/logs /app/media /app/credentials
RUN useradd -r -s /bin/false appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8111
CMD ["app", "serve"]

# ============================================================
# Sophia — environment variable template (OSS)
# ============================================================
# Copy to .env and fill locally (`cp .env.example .env`). Do NOT commit real values.
# Required for `docker compose up`: POSTGRES_PASSWORD, SECRET_KEY
# Secrets are left empty on purpose (a default secret becomes a key everyone knows).
# Generate your own, e.g.  openssl rand -hex 32

# --- DB ---
# For running outside Docker: put the same password as POSTGRES_PASSWORD after "sophia:"
DATABASE_URL=postgresql://sophia:@localhost:5432/sophia
# Required. e.g. openssl rand -hex 16
POSTGRES_PASSWORD=
# Optional helper keys for migration scripts (leave empty in OSS docs):
# PG_HOST= PG_PORT= PG_USER= PG_PASSWORD= PG_DB=
# PG_HOST_PROD= PG_PORT_PROD= PG_USER_PROD= PG_PASSWORD_PROD= PG_DB_PROD=

# --- Web ---
PORT=8111
BASE_URL=http://localhost:8111
# Required. e.g. openssl rand -hex 32
SECRET_KEY=
ENV_NAME=development
ENABLE_SWAGGER_UI=true

# --- First administrator (first start only) ---
# A fresh install has no users. Uncomment and set these BEFORE the first `docker compose up`.
# The admin is created only when there are no users yet. Password rule: 12+ chars with upper case, lower case and digits.
# After the admin exists, delete these lines and run `docker compose up -d --force-recreate`.
# After logging in, register MFA (TOTP or passkey): admin operations are blocked until you do.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_USERNAME=

# --- Optional Features (disabled by default) ---
# Mail auto-import pipeline. Set to true to enable IMAP polling.
MAIL_PIPELINE_ENABLED=false

# --- Mail (SMTP) - Optional feature, disabled by default ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@example.com
# EMAIL_TEST_REDIRECT_TO=
# EMAIL_TEST_ALLOWED_RECIPIENTS=
# EMAIL_INTERNAL_DOMAINS=example.com

# --- IMAP - Optional feature, disabled by default ---
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# --- Google Drive - Optional feature, disabled by default ---
# GOOGLE_DRIVE_CREDENTIALS_FILE=/app/credentials/drive.json
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_DRIVE_IMPERSONATE_EMAIL=

# --- EDI-OASIS - Optional feature, disabled by default ---
# EDI_OASIS_BASE_URL=
# EDI_OASIS_USER=
# EDI_OASIS_PASSWORD=
# EDI_OASIS_COMPANY_NAME=

# --- Peppol - Optional feature, disabled by default ---
# PEPPOL_API_BASE_URL=
# PEPPOL_API_KEY=
# PEPPOL_OWN_PARTICIPANT_ID=
# PEPPOL_WEBHOOK_SECRET=

# --- Cloudflare Tunnel - Optional feature, disabled by default ---
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Webhook / notifications - Optional feature, disabled by default ---
# WEBHOOK_SECRET=
# GOOGLE_CHAT_WEBHOOK_URL=

# --- Ollama (local AI) - Optional feature, disabled by default ---
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=

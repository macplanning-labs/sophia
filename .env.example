# ============================================================
# Sophia — environment variable template (OSS)
# ============================================================
# Copy to .env and fill locally (`cp .env.example .env`). Do NOT commit real values.
# Required for `docker compose up`: POSTGRES_PASSWORD, SECRET_KEY
# Values below are placeholders only.

# --- DB ---
DATABASE_URL=postgresql://sophia:change-me@localhost:5432/sophia
POSTGRES_PASSWORD=change-me
# Optional helper keys for migration scripts (leave empty in OSS docs):
# PG_HOST= PG_PORT= PG_USER= PG_PASSWORD= PG_DB=
# PG_HOST_PROD= PG_PORT_PROD= PG_USER_PROD= PG_PASSWORD_PROD= PG_DB_PROD=

# --- Web ---
PORT=8111
BASE_URL=http://localhost:8111
SECRET_KEY=change-me-to-a-long-random-string
ENV_NAME=development
ENABLE_SWAGGER_UI=true

# --- Mail (SMTP) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_TEST_REDIRECT_TO=
EMAIL_TEST_ALLOWED_RECIPIENTS=

# --- IMAP ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- EDI-OASIS ---
EDI_OASIS_BASE_URL=
EDI_OASIS_USER=
EDI_OASIS_PASSWORD=
EDI_OASIS_COMPANY_NAME=

# --- Peppol ---
PEPPOL_API_BASE_URL=
PEPPOL_API_KEY=
PEPPOL_OWN_PARTICIPANT_ID=
PEPPOL_WEBHOOK_SECRET=

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Webhook / notifications ---
WEBHOOK_SECRET=
GOOGLE_CHAT_WEBHOOK_URL=

# --- Ollama (optional) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
